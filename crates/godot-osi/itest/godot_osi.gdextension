[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.2

[libraries]
; run_itest.ps1 copies the freshly built dll (cargo build --features itest)
; into this project's bin/ before launching Godot.
windows.debug.x86_64 = "res://bin/godot_osi.dll"
windows.release.x86_64 = "res://bin/godot_osi.dll"
